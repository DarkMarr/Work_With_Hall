      m_Items: []
  - m_Id: 1185931275
    m_Localized: "\u65C5\u304C\u5927\u597D\u304D\uFF01\u305F\u3060\u3057\u3001\u9AD8\u78BA\u7387\u3067\u8FF7\u5B50\u306B\u306A\u308B\u6A21\u69D8\u3002"
