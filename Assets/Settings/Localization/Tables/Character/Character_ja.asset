    m_Localized: "\u3044\u3064\u3060\u3063\u3066\u30DD\u30B8\u30C6\u30A3\u30D6\uFF01\u3069\u3093\u306A\u6642\u3082\u7B11\u9854\u3092\u5FD8\u308C\u306A\u3044\u3002"
