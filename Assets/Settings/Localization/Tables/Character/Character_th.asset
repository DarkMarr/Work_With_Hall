  m_Name: Character_th
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: th
  m_SharedData: {fileID: 11400000, guid: b78dc0e1709f95f40bcf06e9b78a3dc6, type: 2}
  m_Metadata:
